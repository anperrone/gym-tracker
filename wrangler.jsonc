{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-tracker",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Il Worker gestisce il routing PRIMA degli asset: senza questo, le richieste
    // di navigazione del browser (Sec-Fetch-Mode: navigate) verso rotte server come
    // /auth/* verrebbero servite come SPA (index.html) invece di raggiungere Hono.
    // Le rotte SPA restano gestite dal catch-all `app.all('*') -> ASSETS.fetch`.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-tracker-db",
      // Id del database D1 remoto (da `wrangler d1 create gym-tracker-db`).
      // Per lo sviluppo `--local` l'id non deve essere reale.
      "database_id": "6451299f-f2e5-4f83-95bd-e3e631777c40",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Contatori per il rate limiting (callback OAuth + mutation).
      "binding": "RATE_LIMIT",
      // Id del namespace KV remoto (da `wrangler kv namespace create RATE_LIMIT`).
      // Per lo sviluppo `--local` l'id non deve essere reale.
      "id": "2857dc8bb66f439d89b6d02931e01490"
    }
  ]
}
